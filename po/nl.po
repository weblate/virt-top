msgid "Sort by %CPU"
msgstr "Sorteer volgens %CPU"

#: src/top.ml:681
msgid "Sort by %MEM"
msgstr "Sorteer volgens %MEM"

#: src/top.ml:683
msgid "Sort by ID"
msgstr "Sorteer volgens ID"

#: src/top.ml:682
msgid "Sort by TIME"
msgstr "Sorteer volgens TIJD"

#: src/top.ml:96
msgid "Start by displaying block devices"
msgstr "Begin met het weergeven van blokapparaten"

#: src/top.ml:94
msgid "Start by displaying network interfaces"
msgstr "Begin met het weergeven van netwerkinterfaces"

#: src/top.ml:92
msgid "Start by displaying pCPUs (default: tasks)"
msgstr "Begin met het weergeven van pCPU's (standaard: taken)"

#: src/types.ml:45
msgid "TIME (CPU time)"
msgstr "TIJD (CPU-tijd)"

#: src/top.ml:704
msgid "Toggle block devices"
msgstr "Schakel blokapparaten om"

#: src/top.ml:703
msgid "Toggle network interfaces"
msgstr "Schakel netwerkinterfaces om"

#: src/top.ml:702
msgid "Toggle physical CPUs"
msgstr "Schakel fysieke CPU's om"

#: src/top.ml:419
msgid "Type key or use up and down cursor keys."
msgstr "Type toets of gebruik omhoog en omlaag cursortoetsen."

#: src/top.ml:713
msgid "Unknown command - try 'h' for help"
msgstr "Onbekend commando - probeer 'h' voor hulp"

#: src/top.ml:667
msgid "Update display"
msgstr "Vernieuw display"

#: src/top.ml:607
msgid "Wrote settings to %s"
msgstr "Instellingen naar %s geschreven"

#: src/top.ml:649
msgid "default"
msgstr "standaard"

#: src/top.ml:135
msgid "dump output to stdout (no userinterface)"
msgstr "dump output naar stdout (geen gebruikersinterface)"

#: src/top.ml:137
msgid "show block device load in bytes rather than reqs"
msgstr "toon blokapparaatbelasting in bytes in plaats van reqs"

#: src/top.ml:671
msgid "toggle block info req/bytes"
msgstr "schakel block info req/bytes om"

#: src/top.ml:629
msgid "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d by Red Hat"
msgstr "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d door Red Hat"

#: src/top.ml:143
msgid ""
"virt-top : a 'top'-like utility for virtualization\n"
"\n"
"SUMMARY\n"
"  virt-top [-options]\n"
"\n"
"OPTIONS"
msgstr ""
"virt-top: een op 'top' lijkend hulpprogramma voor virtualisatie\n"
"\n"
"SAMENVATTING\n"
"  virt-top [-opties]\n"
"\n"
"OPTIES"

