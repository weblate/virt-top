#: src/top.ml:574
msgid "# %s virt-top configuration file\n"
msgstr "# %s virt-top configuratiebestand\n"

#: src/top.ml:592
msgid "# Enable CSV output to the named file\n"
msgstr "# Schakel CSV-uitvoer naar het genoemde bestand in\n"

#: src/top.ml:595
msgid "# To protect this file from being overwritten, uncomment next line\n"
msgstr ""
"# Om te voorkomen dat dit bestand wordt overschreven, verwijder je het "
"commentaar op de volgende regel\n"

#: src/top.ml:589
msgid "# To send debug and error messages to a file, uncomment next line\n"
msgstr ""
"# Als je foutopsporings- en foutmeldingen naar een bestand wilt sturen, "
"verwijder je het commentaar op de volgende regel\n"

#: src/top.ml:575
msgid "# generated on %s by %s\n"
msgstr "# gegenereerd op %s door %s\n"

#: src/types.ml:43
msgid "%CPU"
msgstr "%CPU"

#: src/types.ml:44
msgid "%MEM"
msgstr "%MEM"

#: src/redraw.ml:480
msgid ""
"%d domains, %d active, %d running, %d sleeping, %d paused, %d inactive D:%d "
"O:%d X:%d"
msgstr ""
"%d domeinen, %d actief, %d draaiend, %d slapend, %d gepauzeerd, %d inactieve "
"D:%d O:%d X:%d"

#: src/top.ml:170
msgid "%s: could not parse '%s' in init file: expecting %s"
msgstr "%s: kon '%s' in init-bestand niet ontleden: verwachtte %s"

#: src/top.ml:165
msgid "%s: could not parse '%s' in init file: expecting a number"
msgstr "%s: kon '%s' in init-bestand niet ontleden: verwachtte een getal"

#: src/top.ml:160
msgid "%s: could not parse '%s' in init file: expecting an integer"
msgstr ""
"%s: kon '%s' in init-bestand niet ontleden: verwachtte een geheel getal"

#: src/types.ml:83
msgid "%s: display should be %s"
msgstr "%s: display moet %s zijn"

#: src/types.ml:61
msgid "%s: sort order should be: %s"
msgstr "%s: sorteervolgorde moet worden: %s"

#: src/top.ml:142
msgid "%s: unknown parameter"
msgstr "%s: onbekende parameter"

#: src/top.ml:194
msgid ""
"%s:%d: configuration item ``%s'' ignored\n"
"%!"
msgstr ""
"%s:%d: configuratie-item ``%s'' genegeerd\n"
"%!"

#: src/top.ml:72
msgid "-d: cannot set a negative delay"
msgstr "-d: kan geen negatieve vertraging instellen"

#: src/top.ml:98
msgid "Batch mode"
msgstr "Batch modus"

#: src/types.ml:50
msgid "Block read reqs"
msgstr "Blok lees aanvragen"

#: src/types.ml:51
msgid "Block write reqs"
msgstr "Blok schrijf aanvragen"

