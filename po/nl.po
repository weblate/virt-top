msgid "More help in virt-top(1) man page. Press any key to return."
msgstr ""
"Meer hulp in de virt-top(1) man pagina. Druk op een toets om terug te keren."

#: src/top.ml:219
msgid ""
"NB: If you want to monitor a local hypervisor, you usually need to be root"
msgstr ""
"NB: Als je een lokale hypervisor wilt monitoren, moet je meestal root zijn"

#: src/types.ml:48
msgid "Net RX bytes"
msgstr "Netwerk RX bytes"

#: src/types.ml:49
msgid "Net TX bytes"
msgstr "Netwerk TX bytes"

#: src/top.ml:410
msgid "Not a valid number"
msgstr "Geen geldig getal"

#: src/top.ml:126
msgid "Number of iterations to run"
msgstr "Aantal te draaien iteraties"

#: src/top.ml:644 src/top.ml:643
msgid "Off"
msgstr "Uit"

#: src/top.ml:644 src/top.ml:643
msgid "On"
msgstr "Op"

#: src/top.ml:668
msgid "Quit"
msgstr "Verlaten"

#: src/top.ml:133
msgid "Run from a script (no user interface)"
msgstr "Uitvoeren vanuit een script (geen gebruikersinterface)"

#: src/top.ml:675
msgid "SORTING"
msgstr "SORTEREN"

#: src/top.ml:131
msgid "Secure (\"kiosk\") mode"
msgstr "Veilige (\"kiosk\") modus"

#: src/top.ml:684
msgid "Select sort field"
msgstr "Selecteer sorteer veld"

#: src/top.ml:116
msgid "Send debug messages to file"
msgstr "Stuur debug berichten naar bestand"

#: src/top.ml:122
msgid "Set name of init file"
msgstr "Stel naam van init bestand in"

#: src/top.ml:128
msgid "Set sort order (%s)"
msgstr "Stel sorteervolgorde in (%s)"

#: src/top.ml:418
msgid "Set sort order for main display"
msgstr "Stel sorteervolgorde in voor hoofddisplay"

#: src/top.ml:669
msgid "Set update interval"
msgstr "Stel vernieuw-interval in"

