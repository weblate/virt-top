#: src/top.ml:574
msgid "# %s virt-top configuration file\n"
msgstr "# Plik konfiguracji programu virt-top %s\n"

#: src/top.ml:592
msgid "# Enable CSV output to the named file\n"
msgstr "# Włącza wyjście CSV do pliku named\n"

#: src/top.ml:595
msgid "# To protect this file from being overwritten, uncomment next line\n"
msgstr ""
"# Aby ochronić ten plik przed zastąpieniem, należy usunąć komentarz "
"z następnego wiersza\n"

#: src/top.ml:589
msgid "# To send debug and error messages to a file, uncomment next line\n"
msgstr ""
"# Aby wysłać komunikaty debugowania i błędów do pliku, należy usunąć "
"komentarz z następnego wiersza\n"

#: src/top.ml:575
msgid "# generated on %s by %s\n"
msgstr "# utworzone %s przez %s\n"

#: src/types.ml:43
msgid "%CPU"
msgstr "%CPU"

#: src/types.ml:44
msgid "%MEM"
msgstr "%MEM"

#: src/redraw.ml:480
msgid ""
"%d domains, %d active, %d running, %d sleeping, %d paused, %d inactive D:%d "
"O:%d X:%d"
msgstr ""
"%d domeny, %d aktywne, %d uruchomione, %d uśpione, %d wstrzymane, %d "
"nieaktywne D:%d O:%d X:%d"

#: src/top.ml:170
msgid "%s: could not parse '%s' in init file: expecting %s"
msgstr "%s: nie można przetworzyć „%s” w pliku init: oczekiwano %s"

#: src/top.ml:165
msgid "%s: could not parse '%s' in init file: expecting a number"
msgstr "%s: nie można przetworzyć „%s” w pliku init: oczekiwano liczby"

#: src/top.ml:160
msgid "%s: could not parse '%s' in init file: expecting an integer"
msgstr ""
"%s: nie można przetworzyć „%s” w pliku init: oczekiwano liczby całkowitej"

#: src/types.ml:83
msgid "%s: display should be %s"
msgstr "%s: ekran powinien być %s"

#: src/types.ml:61
msgid "%s: sort order should be: %s"
msgstr "%s: porządek sortowania powinien być: %s"

#: src/top.ml:142
msgid "%s: unknown parameter"
msgstr "%s: nieznany parametr"

#: src/top.ml:194
msgid ""
"%s:%d: configuration item ``%s'' ignored\n"
"%!"
msgstr ""
"%s:%d: zignorowano element konfiguracji „%s”\n"
"%!"

#: src/top.ml:72
msgid "-d: cannot set a negative delay"
msgstr "-d: nie można ustawić ujemnego opóźnienia"

#: src/top.ml:98
msgid "Batch mode"
msgstr "Tryb wsadowy"

#: src/types.ml:50
msgid "Block read reqs"
msgstr "Reqs odczytania blokowego"

#: src/types.ml:51
msgid "Block write reqs"
msgstr "Reqs zapisania blokowego"

#: src/redraw.ml:487
msgid "CPU: %2.1f%%  Mem: %Ld MB (%Ld MB by guests)"
msgstr "Procesor: %2.1f%%  Pamięć: %Ld MB (%Ld MB przez gości)"

#: src/top.ml:397
msgid "Change delay from %.1f to: "
msgstr "Zmień opóźnienie z %.1f na: "

#: src/top.ml:102 src/top.ml:100
msgid "Connect to libvirt URI"
msgstr "Łączy z adresem URI biblioteki libvirt"

#: src/top.ml:648
msgid "Connect: %s; Hostname: %s"
msgstr "Połącz: %s; nazwa gospodarza: %s"

#: src/top.ml:687
msgid "DISPLAY MODES"
msgstr "TRYBY WYŚWIETLANIA"

#: src/top.ml:404
msgid "Delay must be > 0"
msgstr "Opóźnienie musi wynosić > 0"

#: src/top.ml:114
msgid "Delay time interval (seconds)"
msgstr "Czas między opóźnieniami (w sekundach)"

#: src/top.ml:641
msgid "Delay: %.1f secs; Batch: %s; Secure: %s; Sort: %s"
msgstr "Opóźnienie: %.1f s; wsadowo: %s; bezpieczeństwo: %s; sortowanie: %s"

#: src/top.ml:106
msgid "Disable CPU stats in CSV"
msgstr "Wyłącza statystyki procesora w CSV"

#: src/top.ml:110
msgid "Disable block device stats in CSV"
msgstr "Wyłącza statystyki urządzenia blokowego w CSV"

#: src/top.ml:108
msgid "Disable memory stats in CSV"
msgstr "Wyłącza statystyki pamięci w CSV"

#: src/top.ml:112
msgid "Disable net stats in CSV"
msgstr "Wyłącza statystyki sieci w CSV"

#: src/top.ml:139
msgid "Display version number and exit"
msgstr "Wyświetla numer wersji i kończy działanie"

#: src/top.ml:124
msgid "Do not read init file"
msgstr "Bez odczytu pliku init"

#: src/types.ml:46
msgid "Domain ID"
msgstr "Identyfikator domeny"

#: src/types.ml:47
msgid "Domain name"
msgstr "Nazwa domeny"

#: src/top.ml:701
msgid "Domains display"
msgstr "Ekran domen"

#: src/top.ml:615 src/top.ml:612 src/main.ml:69 src/main.ml:44
msgid "Error"
msgstr "Błąd"

#: src/top.ml:118
msgid "Exit at given time"
msgstr "Kończy pracę o podanym czasie"

#: src/top.ml:670
msgid "Help"
msgstr "Pomoc"

#: src/top.ml:120
msgid "Historical CPU delay"
msgstr "Historyczne opóźnienie procesora"

#: src/top.ml:104
msgid "Log statistics to CSV file"
msgstr "Zapisuje statystyki do pliku CSV"

#: src/top.ml:653
msgid "MAIN KEYS"
msgstr "GŁÓWNE KLUCZE"

#: src/top.ml:708
msgid "More help in virt-top(1) man page. Press any key to return."
msgstr ""
"Więcej pomocy na stronie podręcznika virt-top(1). Proszę nacisnąć dowolny "
"klawisz, aby kontynuować."

#: src/top.ml:219
msgid ""
"NB: If you want to monitor a local hypervisor, you usually need to be root"
msgstr "NB: aby monitorować lokalnego nadzorcę, zwykle należy być rootem"

#: src/types.ml:48
msgid "Net RX bytes"
msgstr "Sieciowe bajty RX"

#: src/types.ml:49
msgid "Net TX bytes"
msgstr "Sieciowe bajty TX"

#: src/top.ml:410
msgid "Not a valid number"
msgstr "Nie jest prawidłową liczbą"

#: src/top.ml:126
msgid "Number of iterations to run"
msgstr "Liczba iteracji do wykonania"

#: src/top.ml:644 src/top.ml:643
msgid "Off"
msgstr "Wyłączone"

#: src/top.ml:644 src/top.ml:643
msgid "On"
msgstr "Włączone"

#: src/top.ml:668
msgid "Quit"
msgstr "Zakończ"

#: src/top.ml:133
msgid "Run from a script (no user interface)"
msgstr "Uruchamia ze skryptu (bez interfejsu użytkownika)"

#: src/top.ml:675
msgid "SORTING"
msgstr "SORTOWANIE"

#: src/top.ml:131
msgid "Secure (\"kiosk\") mode"
msgstr "Tryb bezpieczny („kiosk”)"

#: src/top.ml:684
msgid "Select sort field"
msgstr "Wybór pola sortowania"

#: src/top.ml:116
msgid "Send debug messages to file"
msgstr "Wysyła komunikaty debugowania do pliku"

#: src/top.ml:122
msgid "Set name of init file"
msgstr "Ustawia nazwę pliku init"

#: src/top.ml:128
msgid "Set sort order (%s)"
msgstr "Ustawia porządek sortowania (%s)"

#: src/top.ml:418
msgid "Set sort order for main display"
msgstr "Ustawia porządek sortowania dla głównego ekranu"

#: src/top.ml:669
msgid "Set update interval"
msgstr "Ustawia czas między aktualizacjami"

#: src/top.ml:680
msgid "Sort by %CPU"
msgstr "Uporządkowuje według %CPU"

#: src/top.ml:681
msgid "Sort by %MEM"
msgstr "Uporządkowuje według %MEM"

#: src/top.ml:683
msgid "Sort by ID"
msgstr "Uporządkowuje według identyfikatorów"

#: src/top.ml:682
msgid "Sort by TIME"
msgstr "Uporządkowuje według TIME"

#: src/top.ml:96
msgid "Start by displaying block devices"
msgstr "Uruchamia przez wyświetlenie urządzeń blokowych"

#: src/top.ml:94
msgid "Start by displaying network interfaces"
msgstr "Uruchamia przez wyświetlenie interfejsów sieciowych"

#: src/top.ml:92
msgid "Start by displaying pCPUs (default: tasks)"
msgstr ""
"Uruchamia przez wyświetlanie fizycznych procesorów (domyślnie: zadania)"

#: src/types.ml:45
msgid "TIME (CPU time)"
msgstr "TIME (czas procesora)"

#: src/top.ml:704
msgid "Toggle block devices"
msgstr "Przełącza urządzenia blokowe"

#: src/top.ml:703
msgid "Toggle network interfaces"
msgstr "Przełącza interfejsy sieciowe"

#: src/top.ml:702
msgid "Toggle physical CPUs"
msgstr "Przełącza fizyczne procesory"

#: src/top.ml:419
msgid "Type key or use up and down cursor keys."
msgstr "Proszę podać klucz lub użyć klawiszy kursora w górę i w dół."

#: src/top.ml:713
msgid "Unknown command - try 'h' for help"
msgstr "Nieznane polecenie — wpisanie „h” wyświetli pomoc"

#: src/top.ml:667
msgid "Update display"
msgstr "Aktualizuje ekran"

#: src/top.ml:607
msgid "Wrote settings to %s"
msgstr "Zapisano ustawienia do %s"

#: src/top.ml:649
msgid "default"
msgstr "domyślne"

#: src/top.ml:135
msgid "dump output to stdout (no userinterface)"
msgstr "wyświetla wyjście na standardowym wyjściu (bez interfejsu użytkownika)"

#: src/top.ml:137
msgid "show block device load in bytes rather than reqs"
msgstr "wyświetla wykorzystanie urządzenia blokowego w bajtach zamiast w reqs"

#: src/top.ml:671
msgid "toggle block info req/bytes"
msgstr "przełącza reqs/bajty informacji o urządzeniu blokowym"

#: src/top.ml:629
msgid "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d by Red Hat"
msgstr "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d Red Hat"

#: src/top.ml:143
msgid ""
"virt-top : a 'top'-like utility for virtualization\n"
"\n"
"SUMMARY\n"
"  virt-top [-options]\n"
"\n"
"OPTIONS"
msgstr ""
"virt-top: narzędzie podobne do „top” dla wirtualizacji\n"
"\n"
"PODSUMOWANIE\n"
"  virt-top [-opcje]\n"
"\n"
"OPCJE"

#: src/top.ml:39
msgid "virt-top was compiled without support for dates and times"
msgstr "virt-top został skompilowany bez obsługi dat i czasu"

