#: src/top.ml:574
msgid "# %s virt-top configuration file\n"
msgstr "# %s virt-top 設定檔\n"

#: src/top.ml:592
msgid "# Enable CSV output to the named file\n"
msgstr "# 啟用 CSV 輸出至指定檔案\n"

#: src/top.ml:595
msgid "# To protect this file from being overwritten, uncomment next line\n"
msgstr "# 為保護此檔案不被覆寫，請取消下一行的註解\n"

#: src/top.ml:589
msgid "# To send debug and error messages to a file, uncomment next line\n"
msgstr "# 若要將除錯與錯誤訊息傳送至檔案，請取消下一行的註解\n"

#: src/top.ml:575
msgid "# generated on %s by %s\n"
msgstr "# 於 %s 由 %s 產生\n"

#: src/types.ml:43
msgid "%CPU"
msgstr "%CPU"

#: src/types.ml:44
msgid "%MEM"
msgstr "%MEM"

#: src/redraw.ml:480
msgid ""
"%d domains, %d active, %d running, %d sleeping, %d paused, %d inactive D:%d "
"O:%d X:%d"
msgstr ""
"%d 個虛擬機器，%d 個活動，%d 個執行中，%d 個休眠，%d 個暫停，%d 個非活動  "
"D:%d O:%d X:%d"

#: src/top.ml:170
msgid "%s: could not parse '%s' in init file: expecting %s"
msgstr "%s：無法解析初始設定檔中的「%s」：應為 %s"

#: src/top.ml:165
msgid "%s: could not parse '%s' in init file: expecting a number"
msgstr "%s：無法解析初始設定檔中的「%s」：應為數字"

#: src/top.ml:160
msgid "%s: could not parse '%s' in init file: expecting an integer"
msgstr "%s：無法解析初始設定檔中的「%s」：應為整數"

#: src/types.ml:83
msgid "%s: display should be %s"
msgstr "%s：顯示模式應為 %s"

#: src/types.ml:61
msgid "%s: sort order should be: %s"
msgstr "%s：排序方式應為：%s"

#: src/top.ml:142
msgid "%s: unknown parameter"
msgstr "%s: unknown parameter"

#: src/top.ml:194
msgid ""
"%s:%d: configuration item ``%s'' ignored\n"
"%!"
msgstr ""
"%s：%d：設定項目「%s」已忽略\n"
"%!"

#: src/top.ml:72
msgid "-d: cannot set a negative delay"
msgstr "-d：無法設定負數延遲"

#: src/top.ml:98
msgid "Batch mode"
msgstr "批次模式"

#: src/types.ml:50
msgid "Block read reqs"
msgstr "區塊讀取請求"

#: src/types.ml:51
msgid "Block write reqs"
msgstr "區塊寫入請求"

#: src/redraw.ml:487
msgid "CPU: %2.1f%%  Mem: %Ld MB (%Ld MB by guests)"
msgstr "CPU：%2.1f%%  記憶體：%Ld MB（訪客佔用 %Ld MB）"

#: src/top.ml:397
msgid "Change delay from %.1f to: "
msgstr "變更延遲時間（目前 %.1f）： "

#: src/top.ml:102 src/top.ml:100
msgid "Connect to libvirt URI"
msgstr "連線至 libvirt URI"

#: src/top.ml:648
msgid "Connect: %s; Hostname: %s"
msgstr "連線：%s；主機名稱：%s"

#: src/top.ml:687
msgid "DISPLAY MODES"
msgstr "顯示模式"

#: src/top.ml:404
msgid "Delay must be > 0"
msgstr "延遲時間必須大於 0"

#: src/top.ml:114
msgid "Delay time interval (seconds)"
msgstr "延遲時間間隔（秒）"

#: src/top.ml:641
msgid "Delay: %.1f secs; Batch: %s; Secure: %s; Sort: %s"
msgstr "延遲：%.1f 秒；批次：%s；安全模式：%s；排序：%s"

#: src/top.ml:106
msgid "Disable CPU stats in CSV"
msgstr "停用 CSV 中的 CPU 統計"

#: src/top.ml:110
msgid "Disable block device stats in CSV"
msgstr "停用 CSV 中的區塊裝置統計"

#: src/top.ml:108
msgid "Disable memory stats in CSV"
msgstr "停用 CSV 中的記憶體統計"

#: src/top.ml:112
msgid "Disable net stats in CSV"
msgstr "停用 CSV 中的網路統計"

#: src/top.ml:139
msgid "Display version number and exit"
msgstr "顯示版本號碼後結束"

#: src/top.ml:124
msgid "Do not read init file"
msgstr "不讀取初始設定檔"

#: src/types.ml:46
msgid "Domain ID"
msgstr "虛擬機器 ID"

#: src/types.ml:47
msgid "Domain name"
msgstr "虛擬機器名稱"

#: src/top.ml:701
msgid "Domains display"
msgstr "虛擬機器顯示"

#: src/top.ml:615 src/top.ml:612 src/main.ml:69 src/main.ml:44
msgid "Error"
msgstr "錯誤"

#: src/top.ml:118
msgid "Exit at given time"
msgstr "於指定時間結束"

#: src/top.ml:670
msgid "Help"
msgstr "說明"

#: src/top.ml:120
msgid "Historical CPU delay"
msgstr "歷史 CPU 延遲"

#: src/top.ml:104
msgid "Log statistics to CSV file"
msgstr "將統計資料記錄至 CSV 檔案"

#: src/top.ml:653
msgid "MAIN KEYS"
msgstr "主要按鍵"

#: src/top.ml:708
msgid "More help in virt-top(1) man page. Press any key to return."
msgstr "更多說明請參閱 virt-top(1) 手冊頁面。按任意鍵返回。"

#: src/top.ml:219
msgid ""
"NB: If you want to monitor a local hypervisor, you usually need to be root"
msgstr "注意：若要監控本機虛擬機器管理器，通常需要以 root 身分執行"

#: src/types.ml:48
msgid "Net RX bytes"
msgstr "網路接收位元組"

#: src/types.ml:49
msgid "Net TX bytes"
msgstr "網路傳輸位元組"

#: src/top.ml:410
msgid "Not a valid number"
msgstr "不是有效的數字"

#: src/top.ml:126
msgid "Number of iterations to run"
msgstr "執行迭代次數"

#: src/top.ml:644 src/top.ml:643
msgid "Off"
msgstr "關閉"

#: src/top.ml:644 src/top.ml:643
msgid "On"
msgstr "開啟"

#: src/top.ml:668
msgid "Quit"
msgstr "結束"

#: src/top.ml:133
msgid "Run from a script (no user interface)"
msgstr "從指令稿執行（無使用者介面）"

#: src/top.ml:675
msgid "SORTING"
msgstr "排序"

#: src/top.ml:131
msgid "Secure (\"kiosk\") mode"
msgstr "安全（「資訊站」）模式"

#: src/top.ml:684
msgid "Select sort field"
msgstr "選取排序欄位"

#: src/top.ml:116
msgid "Send debug messages to file"
msgstr "將除錯訊息傳送至檔案"

#: src/top.ml:122
msgid "Set name of init file"
msgstr "設定初始設定檔名稱"

#: src/top.ml:128
msgid "Set sort order (%s)"
msgstr "設定排序方式（%s）"

#: src/top.ml:418
msgid "Set sort order for main display"
msgstr "設定主顯示區的排序方式"

#: src/top.ml:669
msgid "Set update interval"
msgstr "設定更新間隔"

#: src/top.ml:680
msgid "Sort by %CPU"
msgstr "依 %CPU 排序"

#: src/top.ml:681
msgid "Sort by %MEM"
msgstr "依 %MEM 排序"

#: src/top.ml:683
msgid "Sort by ID"
msgstr "依 ID 排序"

#: src/top.ml:682
msgid "Sort by TIME"
msgstr "依 TIME 排序"

#: src/top.ml:96
msgid "Start by displaying block devices"
msgstr "啟動時顯示區塊裝置"

#: src/top.ml:94
msgid "Start by displaying network interfaces"
msgstr "啟動時顯示網路介面"

#: src/top.ml:92
msgid "Start by displaying pCPUs (default: tasks)"
msgstr "啟動時顯示實體 CPU（預設：工作）"

#: src/types.ml:45
msgid "TIME (CPU time)"
msgstr "TIME（CPU 時間）"

#: src/top.ml:704
msgid "Toggle block devices"
msgstr "切換區塊裝置"

#: src/top.ml:703
msgid "Toggle network interfaces"
msgstr "切換網路介面"

#: src/top.ml:702
msgid "Toggle physical CPUs"
msgstr "切換實體 CPU"

#: src/top.ml:419
msgid "Type key or use up and down cursor keys."
msgstr "輸入按鍵或使用上下方向鍵。"

#: src/top.ml:713
msgid "Unknown command - try 'h' for help"
msgstr "未知指令——輸入「h」查看說明"

#: src/top.ml:667
msgid "Update display"
msgstr "更新顯示"

#: src/top.ml:607
msgid "Wrote settings to %s"
msgstr "設定已寫入 %s"

#: src/top.ml:649
msgid "default"
msgstr "預設"

#: src/top.ml:135
msgid "dump output to stdout (no userinterface)"
msgstr "將輸出傾印至標準輸出（無使用者介面）"

#: src/top.ml:137
msgid "show block device load in bytes rather than reqs"
msgstr "以位元組顯示區塊裝置負載（取代請求次數）"

#: src/top.ml:671
msgid "toggle block info req/bytes"
msgstr "切換區塊資訊（請求次數/位元組）"

#: src/top.ml:629
msgid "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d by Red Hat"
msgstr "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d（作者：Red Hat）"

#: src/top.ml:143
msgid ""
"virt-top : a 'top'-like utility for virtualization\n"
"\n"
"SUMMARY\n"
"  virt-top [-options]\n"
"\n"
"OPTIONS"
msgstr ""
"virt-top：一個類似「top」的虛擬化工具\n"
"\n"
"摘要\n"
"  virt-top [-options]\n"
"\n"
"選項"

#: src/top.ml:39
msgid "virt-top was compiled without support for dates and times"
msgstr "virt-top 編譯時未包含日期與時間支援"
