#: ../src/top.ml:1670
msgid "# %s virt-top configuration file\n"
msgstr "# %s virt-top -ის კონფიგურაციის ფაილი\n"

#: ../src/top.ml:1688
msgid "# Enable CSV output to the named file\n"
msgstr "# CSV-ის ჩაწერის ჩართვა მითითებულ ფაილში\n"

#: ../src/top.ml:1691
msgid "# To protect this file from being overwritten, uncomment next line\n"
msgstr ""
"# ამ ფაილის თავზე გადაწერისგან დასაცავად, მოხსენით კომენტარი შემდეგ ხაზს\n"

#: ../src/top.ml:1685
msgid "# To send debug and error messages to a file, uncomment next line\n"
msgstr ""
"# გამართვისა და შეცდომების შეტყობინებების ფაილში ჩასაწერად, მოხსენით "
"კომენტარი შემდეგ ხაზს\n"

#: ../src/top.ml:1671
msgid "# generated on %s by %s\n"
msgstr "# გენერირებულია %s-ზე %s-ის მიერ\n"

#: ../src/top.ml:65
msgid "%CPU"
msgstr "%CPU"

#: ../src/top.ml:66
msgid "%MEM"
msgstr "%MEM"

#: ../src/top.ml:1237
msgid ""
"%d domains, %d active, %d running, %d sleeping, %d paused, %d inactive D:%d "
"O:%d X:%d"
msgstr ""
"%d დომენი, %d აქტიურია, %d გაშვებულია, %d-ს სძინავს, %d შეჩერებულია, %d "
"არააქტიურია D:%d O:%d X:%d"

#: ../src/top.ml:245
msgid "%s: could not parse '%s' in init file: expecting %s"
msgstr "%s: init ფილში '%s' -ის დამუშავების შეცდომა: მოველოდი %s"

#: ../src/top.ml:240
msgid "%s: could not parse '%s' in init file: expecting a number"
msgstr "%s: init ფილში '%s' -ის დამუშავების შეცდომა: მოველოდი რიცხვს"

#: ../src/top.ml:235
msgid "%s: could not parse '%s' in init file: expecting an integer"
msgstr "%s: init ფილში '%s' -ის დამუშავების შეცდომა: მოველოდი მთელ რიცხვს"

#: ../src/top.ml:105
msgid "%s: display should be %s"
msgstr "%s: ეკრანი %s უნდა იყოს"

#: ../src/top.ml:83
msgid "%s: sort order should be: %s"
msgstr "%s: დალაგების მიმდევრობა უნდა იყოს: %s"

#: ../src/top.ml:217
msgid "%s: unknown parameter"
msgstr "%s: უცნობი პარამეტრი"

#: ../src/top.ml:269
msgid ""
"%s:%d: configuration item ``%s'' ignored\n"
"%!"
msgstr ""
"%s:%d: კონფიგურაცის ელემენტი ``%s'' გამოტოვებულია\n"
"%!"

#: ../src/top.ml:147
msgid "-d: cannot set a negative delay"
msgstr "-d: უარყოფითი დაყოვნების დაყენება შეუძლებელია"

#: ../src/top.ml:173
msgid "Batch mode"
msgstr "პაკეტური რეჟიმი"

#: ../src/top.ml:72
msgid "Block read reqs"
msgstr "ბლოკის წაკითხვის მოთხოვნები"

#: ../src/top.ml:73
msgid "Block write reqs"
msgstr "ბლოკის ჩაწერის მოთხოვნები"

#: ../src/top.ml:1244
msgid "CPU: %2.1f%%  Mem: %Ld MB (%Ld MB by guests)"
msgstr "CPU: %2.1f%%  მეხს: %Ld მნ (%Ld მბ სტუმრების მიერ)"

#: ../src/top.ml:1493
msgid "Change delay from %.1f to: "
msgstr "დაყოვნების მნიშვნელობის შეცვლა %.1f -დან: "

#: ../src/top.ml:177 ../src/top.ml:175
msgid "Connect to libvirt URI"
msgstr "Libvirt-ის URI-ზე მიერთება"

#: ../src/top.ml:1744
msgid "Connect: %s; Hostname: %s"
msgstr "დაკავშირება: %s; ჰოსტის სახელი: %s"

#: ../src/top.ml:1783
msgid "DISPLAY MODES"
msgstr "ჩვენების რეჟიმები"

#: ../src/top.ml:1500
msgid "Delay must be > 0"
msgstr "დაყოვნება უნდა იყოს > 0"

#: ../src/top.ml:189
msgid "Delay time interval (seconds)"
msgstr "დაყოვნების დროის ინტერვალი (წამებში)"

#: ../src/top.ml:1737
msgid "Delay: %.1f secs; Batch: %s; Secure: %s; Sort: %s"
msgstr "დაყოვნება: %.1f წმ; პაკეტი: %s; დაცული: %s; დალაგება: %s"

#: ../src/top.ml:181
msgid "Disable CPU stats in CSV"
msgstr "CSV-ში CPU-ის სტატისტიკის გამორთვა"

#: ../src/top.ml:185
msgid "Disable block device stats in CSV"
msgstr "ბლოკური მოწყობილობების სტატისტიკის გამორთვა CSV-ში"

#: ../src/top.ml:183
msgid "Disable memory stats in CSV"
msgstr "მეხსიერების სტატისტიკის გამორთვა CSV-ში"

#: ../src/top.ml:187
msgid "Disable net stats in CSV"
msgstr "ქსელის სტატისტიკის გამორთვა CSV-ში"

#: ../src/top.ml:214
msgid "Display version number and exit"
msgstr "ვერსიის ჩვენება და გასვლა"

#: ../src/top.ml:199
msgid "Do not read init file"
msgstr "არ წაიკითხო init ფაილი"

#: ../src/top.ml:68
msgid "Domain ID"
msgstr "დომენის ID"

#: ../src/top.ml:69
msgid "Domain name"
msgstr "დომენის სახელი"

#: ../src/top.ml:1797
msgid "Domains display"
msgstr "დომენების ჩვენება"

#: ../src/main.ml:69 ../src/main.ml:44 ../src/top.ml:1711 ../src/top.ml:1708
msgid "Error"
msgstr "შეცდომა"

#: ../src/top.ml:193
msgid "Exit at given time"
msgstr "გასვლა მითითებულ დროს"

#: ../src/top.ml:1766
msgid "Help"
msgstr "დახმარება"

#: ../src/top.ml:195
msgid "Historical CPU delay"
msgstr "CPU-ის დაყოვნების ისტორია"

#: ../src/top.ml:179
msgid "Log statistics to CSV file"
msgstr "სტატისტიკის ჩაწერა CSV ფაილში"

#: ../src/top.ml:1749
msgid "MAIN KEYS"
msgstr "მთავარი ღილაკები"

#: ../src/top.ml:1804
msgid "More help in virt-top(1) man page. Press any key to return."
msgstr ""
"მეტი დამხმარება virt-top(1) man გვერდზე. დასაბრუნებლად დააწექით ნებისმიერ "
"ღილაკს."

#: ../src/top.ml:294
msgid ""
"NB: If you want to monitor a local hypervisor, you usually need to be root"
msgstr ""
"NB: ლოკალური ჰაიპერვაიზორის მონიტორინგისთვის, ჩვეულებრივ, root-ის უფლებები "
"გჭირდებათ"

#: ../src/top.ml:70
msgid "Net RX bytes"
msgstr "ქსელის RX ბაიტი"

#: ../src/top.ml:71
msgid "Net TX bytes"
msgstr "ქსელის TX ბაიტი"

#: ../src/top.ml:1506
msgid "Not a valid number"
msgstr "სწორი რიცხვი არაა"

#: ../src/top.ml:201
msgid "Number of iterations to run"
msgstr "მოსახდენი იტერაციების რიცხვი"

#: ../src/top.ml:1740 ../src/top.ml:1739
msgid "Off"
msgstr "გამორთ"

#: ../src/top.ml:1740 ../src/top.ml:1739
msgid "On"
msgstr "ჩართ"

#: ../src/top.ml:1764
msgid "Quit"
msgstr "გასვლა"

#: ../src/top.ml:208
msgid "Run from a script (no user interface)"
msgstr "სკრიპტიდან გაშვება (მომხმარებლის ინტერფეისის გარეშე)"

#: ../src/top.ml:1771
msgid "SORTING"
msgstr "დალაგება"

#: ../src/top.ml:206
msgid "Secure (\"kiosk\") mode"
msgstr "დაცული (\"კიოსკის\") რეჟიმი"

#: ../src/top.ml:1780
msgid "Select sort field"
msgstr "აირჩიეთ დალაგების ველი"

#: ../src/top.ml:191
msgid "Send debug messages to file"
msgstr "გამართვის შეტყობინებების ფაილში ჩაწერა"

#: ../src/top.ml:197
msgid "Set name of init file"
msgstr "Init ფაილის სახელის დაყენება"

#: ../src/top.ml:203
msgid "Set sort order (%s)"
msgstr "დალაგების მიმდევრობის დაყენება (%s)"

#: ../src/top.ml:1514
msgid "Set sort order for main display"
msgstr "მთავარი ეკრანის დალაგების მიმდევრობის დაყენება"

#: ../src/top.ml:1765
msgid "Set update interval"
msgstr "განახლების ინტერვალის დაყენება"

#: ../src/top.ml:1776
msgid "Sort by %CPU"
msgstr "CPU %-ით დალაგება"

#: ../src/top.ml:1777
msgid "Sort by %MEM"
msgstr "%MEM-ით დალაგება"

#: ../src/top.ml:1779
msgid "Sort by ID"
msgstr "ID-ით დალაგება"

#: ../src/top.ml:1778
msgid "Sort by TIME"
msgstr "დროით დალაგება"

#: ../src/top.ml:171
msgid "Start by displaying block devices"
msgstr "ბლოკური მოწყობილობების ჩვენებით დაწყება"

#: ../src/top.ml:169
msgid "Start by displaying network interfaces"
msgstr "ქსელური ინტერფეისების ჩვენებით დაწყება"

#: ../src/top.ml:167
msgid "Start by displaying pCPUs (default: tasks)"
msgstr "\"pCPU\"-ების ჩვენებით დაწყება (ნაგულისხმები: ამოცანები)"

#: ../src/top.ml:67
msgid "TIME (CPU time)"
msgstr "TIME (CPU -ის დრო)"

#: ../src/top.ml:1800
msgid "Toggle block devices"
msgstr "ბლოკური მოწყობილობების გადართვა"

#: ../src/top.ml:1799
msgid "Toggle network interfaces"
msgstr "ქსელური ინტერფეისების გადართვა"

#: ../src/top.ml:1798
msgid "Toggle physical CPUs"
msgstr "ფიზიკური CPU-ების გადართვა"

#: ../src/top.ml:1515
msgid "Type key or use up and down cursor keys."
msgstr "დააწექით ღილაკს ან გამოიყენეთ მაღლა და დაბლა მაჩვენებელი ღილაკები."

#: ../src/top.ml:1809
msgid "Unknown command - try 'h' for help"
msgstr "უცნობი ბრძანება - დახმარებისთვის სცადეთ 'h'"

#: ../src/top.ml:1763
msgid "Update display"
msgstr "ეკრანის განახლება"

#: ../src/top.ml:1703
msgid "Wrote settings to %s"
msgstr "პარამეტრები ჩაწერილია ფაილში \"%s\""

#: ../src/top.ml:1745
msgid "default"
msgstr "ნაგულისხმები"

#: ../src/top.ml:210
msgid "dump output to stdout (no userinterface)"
msgstr "გამოტანა stdout-ზე (მომხმარებლის ინტერფეისის გარეშე)"

#: ../src/opt_xml.ml:46
msgid "get_xml_desc didn't return <domain/>"
msgstr "get_xml_desc-მა არ დააბრუნა <domain/>"

#: ../src/top.ml:212
msgid "show block device load in bytes rather than reqs"
msgstr "ბლოკური მოწყობილობების დატვირთვის მოთხოვნების მაგიერ ბაიტებში ჩვენება"

#: ../src/top.ml:1767
msgid "toggle block info req/bytes"
msgstr "დისკების ინფორმაციის გადართვა მოთხ/ბაიტ"

#: ../src/top.ml:1725
msgid "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d by Red Hat"
msgstr "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d Red Hat-სგან"

#: ../src/top.ml:218
msgid ""
"virt-top : a 'top'-like utility for virtualization\n"
"\n"
"SUMMARY\n"
"  virt-top [-options]\n"
"\n"
"OPTIONS"
msgstr ""
"virt-top : a 'top'-ის მაგვარ ხელსაწყო ვირტუალიზაციისთვის\n"
"\n"
"მიმოხილვა\n"
"  virt-top [-პარამეტრები]\n"
"\n"
"პარამეტრები"

#: ../src/top.ml:42
msgid "virt-top was compiled without support for CSV files"
msgstr "virt-top აგებულია CSV ფაილების აგების გარეშე"

#: ../src/top.ml:53
msgid "virt-top was compiled without support for dates and times"
msgstr "virt-top თარიღისა და დროის მხარდაჭერის გარეშეა აგებული"
