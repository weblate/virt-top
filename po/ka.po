msgstr "მოსახდენი იტერაციების რიცხვი"

#: src/top.ml:644 src/top.ml:643
msgid "Off"
msgstr "გამორთ"

#: src/top.ml:644 src/top.ml:643
msgid "On"
msgstr "ჩართ"

#: src/top.ml:668
msgid "Quit"
msgstr "გასვლა"

