#: src/top.ml:574
msgid "# %s virt-top configuration file\n"
msgstr "# %s fitxer de configuració de virt-top\n"

#: src/top.ml:592
msgid "# Enable CSV output to the named file\n"
msgstr "# Habilita la sortida CSV al fitxer named\n"

#: src/top.ml:595
msgid "# To protect this file from being overwritten, uncomment next line\n"
msgstr ""
"# Per protegir aquest fitxer de ser sobreescrit, descomenteu la següent "
"línia\n"

#: src/top.ml:589
msgid "# To send debug and error messages to a file, uncomment next line\n"
msgstr ""
"# Per a enviar missatges de depuració o d'error a un fitxer, descomenteu la "
"següent línia\n"

#: src/top.ml:575
msgid "# generated on %s by %s\n"
msgstr "# generat el %s per %s\n"

#: src/types.ml:43
msgid "%CPU"
msgstr "%CPU"

#: src/types.ml:44
msgid "%MEM"
msgstr "%MEM"

#: src/redraw.ml:480
msgid ""
"%d domains, %d active, %d running, %d sleeping, %d paused, %d inactive D:%d "
"O:%d X:%d"
msgstr ""
"%d domini(s), %d en actiu, %d en execució, %d dormint, %d en pausa, %d "
"inactiu(s) D:%d O:%d X:%d"

#: src/top.ml:170
msgid "%s: could not parse '%s' in init file: expecting %s"
msgstr "%s: no s'ha pogut analitzar «%s» al fitxer init: s'esperava %s"

#: src/top.ml:165
msgid "%s: could not parse '%s' in init file: expecting a number"
msgstr "%s: no s'ha pogut analitzar «%s» al fitxer init: s'esperava un número"

#: src/top.ml:160
msgid "%s: could not parse '%s' in init file: expecting an integer"
msgstr "%s: no s'ha pogut analitzar «%s» al fitxer init: s'esperava un enter"

#: src/types.ml:83
msgid "%s: display should be %s"
msgstr "%s: la pantalla hauria de ser %s"

#: src/types.ml:61
msgid "%s: sort order should be: %s"
msgstr "%s: l'ordre d'ordenació hauria de ser: %s"

#: src/top.ml:142
msgid "%s: unknown parameter"
msgstr "%s: paràmetre desconegut"

#: src/top.ml:194
msgid ""
"%s:%d: configuration item ``%s'' ignored\n"
"%!"
msgstr ""
"%s:%d: l'element de configuració «%s» s'ha ignorat\n"
"%!"

#: src/top.ml:72
msgid "-d: cannot set a negative delay"
msgstr "-d: no pot establir un retard negatiu"

#: src/top.ml:98
msgid "Batch mode"
msgstr "Mode per lots"

#: src/types.ml:50
msgid "Block read reqs"
msgstr "Sol·licituds de lectura de blocs"

#: src/types.ml:51
msgid "Block write reqs"
msgstr "Sol·licituds d'escriptura de blocs"

#: src/redraw.ml:487
msgid "CPU: %2.1f%%  Mem: %Ld MB (%Ld MB by guests)"
msgstr "CPU: %2.1f%%  Mem: %Ld MB (%Ld MB per als convidats)"

#: src/top.ml:397
msgid "Change delay from %.1f to: "
msgstr "Canvia el retard de %.1f a: "

#: src/top.ml:102 src/top.ml:100
msgid "Connect to libvirt URI"
msgstr "Connecta a l'URI de libvirt"

#: src/top.ml:648
msgid "Connect: %s; Hostname: %s"
msgstr "Connexió: %s; Nom amfitrió: %s"

#: src/top.ml:687
msgid "DISPLAY MODES"
msgstr "MODES DE VISUALITZACIÓ"

#: src/top.ml:404
msgid "Delay must be > 0"
msgstr "El retard ha de ser > 0"

#: src/top.ml:114
msgid "Delay time interval (seconds)"
msgstr "Interval del retard (segons)"

#: src/top.ml:641
msgid "Delay: %.1f secs; Batch: %s; Secure: %s; Sort: %s"
msgstr "Retard: %.1f s; Per lots: %s; Seguretat: %s; Ordenació: %s"

#: src/top.ml:106
msgid "Disable CPU stats in CSV"
msgstr "En el CSV, inhabilita les estadístiques de la CPU"

#: src/top.ml:110
msgid "Disable block device stats in CSV"
msgstr "En el CSV, inhabilita les estadístiques dels dispositius de blocs"

#: src/top.ml:108
msgid "Disable memory stats in CSV"
msgstr "En el CSV, inhabilita les estadístiques de la memòria"

#: src/top.ml:112
msgid "Disable net stats in CSV"
msgstr "En el CSV, inhabilita les estadístiques de la xarxa"

#: src/top.ml:139
msgid "Display version number and exit"
msgstr "Mostra la versió i surt"

#: src/top.ml:124
msgid "Do not read init file"
msgstr "No llegeix el fitxer d'inicialització"

#: src/types.ml:46
msgid "Domain ID"
msgstr "ID del domini"

#: src/types.ml:47
msgid "Domain name"
msgstr "Nom del domini"

#: src/top.ml:701
msgid "Domains display"
msgstr "Visualització dels dominis"

#: src/top.ml:615 src/top.ml:612 src/main.ml:69 src/main.ml:44
msgid "Error"
msgstr "Error"

#: src/top.ml:118
msgid "Exit at given time"
msgstr "Surt en l'hora indicada"

#: src/top.ml:670
msgid "Help"
msgstr "Ajuda"

#: src/top.ml:120
msgid "Historical CPU delay"
msgstr "Retard en l'històric de la CPU"

#: src/top.ml:104
msgid "Log statistics to CSV file"
msgstr "Enregistra les estadístiques al fitxer CSV"

#: src/top.ml:653
msgid "MAIN KEYS"
msgstr "TECLES PRINCIPALS"

#: src/top.ml:708
msgid "More help in virt-top(1) man page. Press any key to return."
msgstr ""
"Més informació en la pàgina man virt-top(1). Premeu qualsevol tecla per "
"tornar."

#: src/top.ml:219
msgid ""
"NB: If you want to monitor a local hypervisor, you usually need to be root"
msgstr ""
"N.B.: Si voleu monitorar un hipervisor local, normalment heu de ser root"

#: src/types.ml:48
msgid "Net RX bytes"
msgstr "Xarxa RX bytes"

#: src/types.ml:49
msgid "Net TX bytes"
msgstr "Xarxa TX bytes"

#: src/top.ml:410
msgid "Not a valid number"
msgstr "No és un número vàlid"

#: src/top.ml:126
msgid "Number of iterations to run"
msgstr "Nombre d'iteracions a executar"

#: src/top.ml:644 src/top.ml:643
msgid "Off"
msgstr "Apagat"

#: src/top.ml:644 src/top.ml:643
msgid "On"
msgstr "Encès"

#: src/top.ml:668
msgid "Quit"
msgstr "Surt"

#: src/top.ml:133
msgid "Run from a script (no user interface)"
msgstr "Executa des d'un script (sense interfície gràfica)"

#: src/top.ml:675
msgid "SORTING"
msgstr "ORDENACIÓ"

#: src/top.ml:131
msgid "Secure (\"kiosk\") mode"
msgstr "Mode (\"kiosk\") segur"

#: src/top.ml:684
msgid "Select sort field"
msgstr "Selecciona camp d'ordenació"

#: src/top.ml:116
msgid "Send debug messages to file"
msgstr "Envia els missatges de depuració al fitxer"

#: src/top.ml:122
msgid "Set name of init file"
msgstr "Estableix el nom del fitxer d'inicialització"

#: src/top.ml:128
msgid "Set sort order (%s)"
msgstr "Estableix el mètode d'ordenació (%s)"

#: src/top.ml:418
msgid "Set sort order for main display"
msgstr "Estableix el mètode d'ordenació per a la pantalla principal"

#: src/top.ml:669
msgid "Set update interval"
msgstr "Interval d'actualització"

#: src/top.ml:680
msgid "Sort by %CPU"
msgstr "Ordena per %CPU"

#: src/top.ml:681
msgid "Sort by %MEM"
msgstr "Ordena per %MEM"

#: src/top.ml:683
msgid "Sort by ID"
msgstr "Ordena per ID"

#: src/top.ml:682
msgid "Sort by TIME"
msgstr "Ordena per TEMPS"

#: src/top.ml:96
msgid "Start by displaying block devices"
msgstr "Comença mostrant els dispositius de blocs"

#: src/top.ml:94
msgid "Start by displaying network interfaces"
msgstr "Comença mostrant les interfícies de xarxa"

#: src/top.ml:92
msgid "Start by displaying pCPUs (default: tasks)"
msgstr "Comença mostrant pCPUs (predeterminat: tasques)"

#: src/types.ml:45
msgid "TIME (CPU time)"
msgstr "TEMPS (temps de CPU)"

#: src/top.ml:704
msgid "Toggle block devices"
msgstr "Commuta dispositius de blocs"

#: src/top.ml:703
msgid "Toggle network interfaces"
msgstr "Commuta interfícies de xarxa"

#: src/top.ml:702
msgid "Toggle physical CPUs"
msgstr "Commuta CPU físiques"

#: src/top.ml:419
msgid "Type key or use up and down cursor keys."
msgstr "Teclegeu una tecla o utilitzeu les fletxes del cursor amunt o avall."

#: src/top.ml:713
msgid "Unknown command - try 'h' for help"
msgstr "Ordre no reconeguda - proveu «h» per l'ajuda"

#: src/top.ml:667
msgid "Update display"
msgstr "Actualitza la pantalla"

#: src/top.ml:607
msgid "Wrote settings to %s"
msgstr "S'han escrit les preferències a %s"

#: src/top.ml:649
msgid "default"
msgstr "predet."

#: src/top.ml:135
msgid "dump output to stdout (no userinterface)"
msgstr "bolca la sortida a stdout (sense interfícies d'usuari)"

#: src/top.ml:137
msgid "show block device load in bytes rather than reqs"
msgstr "mostra la càrrega del dispositiu de blocs en bytes en lloc de reqs"

#: src/top.ml:671
msgid "toggle block info req/bytes"
msgstr "commuta req/bytes d'info del bloc"

#: src/top.ml:629
msgid "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d by Red Hat"
msgstr "virt-top %s ocaml-libvirt %s libvirt %d.%d.%d per Red Hat"

#: src/top.ml:143
msgid ""
"virt-top : a 'top'-like utility for virtualization\n"
"\n"
"SUMMARY\n"
"  virt-top [-options]\n"
"\n"
"OPTIONS"
msgstr ""
"virt-top: una utilitat similar a «top» per a la virtualització\n"
"\n"
"RESUM\n"
"  virt-top [-opcions]\n"
"\n"
"OPCIONS"

#: src/top.ml:39
msgid "virt-top was compiled without support for dates and times"
msgstr "virt-top fou compilat sense compatibilitat per data i hora"

